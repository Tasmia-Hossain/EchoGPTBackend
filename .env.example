DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/echogpt_db?schema=public"

PORT=3000
NODE_ENV=development

# Replace these placeholders with independently generated secrets of at least 32 characters.
JWT_SECRET="replace-this-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace-this-with-another-random-secret-of-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Placeholder is exactly 32 printable characters. Replace it with a random 32-byte value.
AI_PROVIDER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Optional. Provider API keys can instead be entered through the admin provider API.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Required only when running the database seed script (not for application startup).
SEED_ADMIN_EMAIL="admin@echogpt.dev"
SEED_ADMIN_PASSWORD=""
